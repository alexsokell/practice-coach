# Copy this file to .env and fill in your key. .env is git-ignored.

# Claude API key from https://platform.claude.com (billed per use).
# Leave it empty to run the built-in offline coach (no API calls, no cost).
ANTHROPIC_API_KEY=

# Model that coaches you. claude-opus-5-5 is the default.
# claude-haiku-5-5 is much cheaper and faster, with simpler feedback.
COACH_MODEL=claude-opus-5-5

# How hard the model thinks before it answers: low | medium | high.
# low keeps replies quick, which matters while you are sitting at the piano.
COACH_EFFORT=low

# Where the app listens. Keep 127.0.0.1 unless you know why you are changing it:
# anyone who can reach this port can spend your API key.
HOST=127.0.0.1
PORT=5173

# Set to 1 to force the offline coach even when a key is present.
COACH_MOCK=
